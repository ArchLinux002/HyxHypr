{
	"layer": "top",
	"position": "top",
	"height": 32,

	"modules-center":[
		"custom/active-window",
		"hyprland/workspaces"
	],
	"modules-left":[
		"clock",
		"battery",
		"cpu",
		"memory"
	],
	"modules-right":[
		"pulseaudio",
		"network"
	],

	"hyprland/workspaces":{
		"format": "{name}",
		"persistent-workspaces":{
			"*": 1
		}
	},

	"clock":{
		"interval": 1,
		"format":"⌛︎{:%H:%M:%S}",
		"tooltip-format":"{:%A, %d %B %Y}"
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰖁 Muted",
		"format-icons": {
			"default": [
				"󰕿",
				"󰖀",
				"󰕾"
			]
		},
		"on-click": "pavucontrol",
		"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"scroll-step": 5
	},

	"network": {
    		"interval": 2,

    		"format-wifi": "{essid} | {ifname} | {signalStrength}% | IP: {ipaddr} | GW: {gwaddr} | ↓ {bandwidthDownBits} ↑ {bandwidthUpBits}",

    		"format-ethernet": "{ifname} | IP: {ipaddr} | GW: {gwaddr} | ↓ {bandwidthDownBits} ↑ {bandwidthUpBits}",

    		"format-disconnected": "Disconnected",

    		"tooltip-format-wifi": "Wi-Fi: {essid}\nInterface: {ifname}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}\n↓ Download: {bandwidthDownBits}\n↑ Upload: {bandwidthUpBits}",

    		"tooltip-format-ethernet": "Ethernet\nInterface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}\n↓ Download: {bandwidthDownBits}\n↑ Upload: {bandwidthUpBits}",

    		"tooltip-format-disconnected": "Network: Disconnected",

    		"on-click": "nm-connection-editor"
	},

	"battery":{
		"interval": 5,
		"format": "{icon}:{capacity}%",
		"format-charging": "⚡︎:{capacity}%",
		"format-icons":[
		"⚡︎- ",
		"⚡︎/ ",
		"⚡︎+ "
		]
	},

	"cpu":{
		"interval": 2,
		"format":"CPU: {usage}%",
		"tooltip": true,
		"tooltip-format": "CPU:",

	},
	"memory":{
		"interval": 2,
		"format": "RAM: {percentage}%",
		"tooltip": true,
		"tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
	},

}

